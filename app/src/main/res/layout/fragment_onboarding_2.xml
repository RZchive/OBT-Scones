<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="130dp"
        android:layout_height="130dp"
        app:cardBackgroundColor="@color/app_surface"
        app:cardCornerRadius="65dp"
        app:cardElevation="6dp"
        app:strokeColor="@color/primary_sky_blue"
        app:strokeWidth="2dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Onboard 2"
            android:scaleType="centerCrop"
            android:src="@drawable/riaubg" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:fontFamily="sans-serif-black"
        android:text="Manajemen LPK &amp; Pelatihan"
        android:textAlignment="center"
        android:textColor="@color/app_text_primary"
        android:textSize="24sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Kelola data lembaga pelatihan kerja, program, dan sertifikasi dengan mudah dan terintegrasi."
        android:textAlignment="center"
        android:textColor="@color/app_text_secondary"
        android:textSize="16sp" />

</LinearLayout>
