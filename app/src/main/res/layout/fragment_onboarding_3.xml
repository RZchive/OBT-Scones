<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:contentDescription="Onboard 3"
        android:src="@drawable/scone" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="sans-serif-black"
        android:text="Analisis &amp; Laporan Lengkap"
        android:textColor="@color/app_text_primary"
        android:textSize="24sp"
        android:textAlignment="center" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Pantau statistik kelulusan dan ekspor laporan data pelatihan ke format PDF atau Excel secara instan."
        android:textColor="@color/app_text_secondary"
        android:textSize="16sp"
        android:textAlignment="center" />

</LinearLayout>
